# Copy to .env.local (gitignored) and fill in real values.
# Local dev defaults match docker-compose.yml's Postgres container.

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=gettogether
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSL=false

# S3 bucket for event Planning-tab photo uploads (Story 12.2). Bucket policy
# needs public GetObject + PutObject/DeleteObject for the app's AWS identity.
AWS_S3_EVENT_PHOTOS_BUCKET=
