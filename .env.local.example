# Copy to .env.local (gitignored) and fill in real values.
# Local dev defaults match docker-compose.yml's Postgres container.

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=gettogether
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSL=false

# S3 bucket for event Planning-tab photo uploads (Story 12.2).
S3_EVENT_PHOTOS_BUCKET=

# AWS credentials for S3, SNS (SMS), and Cognito admin operations (magic-link auth).
# AWS_REGION is used by SNS and Cognito clients.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Google Calendar OAuth (Story 3.5). Create an OAuth 2.0 Client ID (Web application)
# in Google Cloud Console; add GOOGLE_REDIRECT_URI as an authorized redirect URI there.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback

# Base64-encoded 32-byte (AES-256) key used to encrypt sensitive columns that must be
# decrypted later (e.g. calendar_connections.refresh_token_encrypted), unlike the
# one-way bcrypt hashing used elsewhere. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Shared secret checked against the x-sync-secret header on POST /api/calendar/sync
# (Story 3.6). This route runs the Google Calendar sync job for all connected users and
# has no logged-in user context, so it's protected by this secret instead of session
# auth -- set it here AND on whatever triggers the sync (EventBridge -> Lambda, etc.).
# Generate with the same command as ENCRYPTION_KEY above.
CALENDAR_SYNC_SECRET=
